# Zoth X Connector — Example Vault Environment (copy to ~/.config/zoth-vault/x.env with chmod 600)
# Never commit real API keys or OAuth tokens to git.

X_API_KEY=your_consumer_api_key
X_API_SECRET=your_consumer_api_secret
X_BEARER_TOKEN=your_app_bearer_token
X_CLIENT_ID=your_oauth2_client_id
X_CLIENT_SECRET=your_oauth2_client_secret

# Per-account OAuth 1.0a User Access Tokens (replace <HANDLE_UPPER> with e.g. ZOTH_OS, NEALFRAZIERTECH, etc.)
X_ACCESS_TOKEN=your_default_user_access_token
X_ACCESS_SECRET=your_default_user_access_secret
X_TOKEN_ZOTH_OS=your_user_access_token
X_SECRET_ZOTH_OS=your_user_access_secret
